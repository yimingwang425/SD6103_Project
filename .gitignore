# Hawker-geo: derived files that rebuild in seconds from what IS committed.
# Both routing caches ARE committed on purpose - osrm_cache.jsonl saves a
# 37-minute re-route, onemap_full.jsonl saves a 2-hour one (OneMap has no
# matrix endpoint, so every pair is a separate request).
data/hawker_geo/hdb_hawker_walk.csv
data/hawker_geo/onemap_cache.jsonl
data/hawker_geo/hdb_hawker_walk_onemap.csv

# Hawker-geo: audit byproducts. Each rebuilds in seconds from the committed
# caches above (rerun 03, or 04 --engine onemap --merge-only); their summaries
# live in the report, so the per-row CSVs stay local.
data/hawker_geo/method_comparison.csv
data/hawker_geo/hdb_block_nearest.csv
data/hawker_geo/onemap_distances.csv
